# Copy this file to .env for local development.
# On Render, DATABASE_URL and JWT_SECRET are set automatically by render.yaml —
# you only need to add ANTHROPIC_API_KEY there if you want the real-LLM chatbot.

# Postgres connection string. Locally, point this at any Postgres instance,
# e.g. postgres://postgres:postgres@localhost:5432/ecoserve
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecoserve

# Secret used to sign login sessions (JWTs). Use a long random string.
JWT_SECRET=change-this-to-a-long-random-string

# Optional. If set, the AI chatbot calls the real Claude API for open-ended
# conversation. If left unset, the chatbot automatically falls back to the
# built-in sustainability assistant — no external calls, no cost.
ANTHROPIC_API_KEY=

# Required to use the /admin page (early access requests + registered
# hotels). Pick your own password — without this set, /admin refuses to
# log anyone in.
ADMIN_PASSWORD=

# Port the server listens on (Render sets this for you in production).
PORT=3000
